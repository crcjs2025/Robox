.b3-modal-dialog .modal-dialog-buttons button:focus { border: 1px solid rgb(77, 144, 254); }

.b3-modal-dialog .modal-dialog-buttons button[disabled] { box-shadow: none; background: none rgb(255, 255, 255); border: 1px solid rgba(0, 0, 0, 0.05); color: rgb(184, 184, 184); }

